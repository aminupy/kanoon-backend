KANOON_ENVIRONMENT=development
KANOON_DEBUG=false
KANOON_DATABASE_DSN=postgresql+psycopg://kanoon_owner:kanoon_owner@localhost:5432/kanoon
KANOON_DATABASE_APPLICATION_ROLE=kanoon_app
KANOON_SIGNING_KEY=replace-with-at-least-32-random-characters
KANOON_TRUST_FORWARDED_HOST=false
KANOON_TRUSTED_PROXY_CIDRS=[]
KANOON_ALLOWED_CORS_ORIGINS=[]
KANOON_DATA_PLANE_HOST=0.0.0.0
KANOON_DATA_PLANE_PORT=8000
KANOON_CONTROL_PLANE_HOST=127.0.0.1
KANOON_CONTROL_PLANE_PORT=8001
KANOON_OTP_PROVIDER=mock
KANOON_PAYMENT_PROVIDER=mock
KANOON_PUBLIC_BASE_URL=http://localhost:8000
# Separate build worker; use a random 32+ character secret outside development.
# KANOON_SITE_BUILD_WEBHOOK_URL=https://builder.internal.example/v1/builds
KANOON_SITE_BUILD_HMAC_SECRET=development-site-build-secret-change-me
KANOON_SITE_BUILD_MAX_ATTEMPTS=5
KANOON_SITE_BUILD_LEASE_SECONDS=300
KANOON_SITE_BUILD_POLL_SECONDS=5
KANOON_S3_ENDPOINT_URL=http://localhost:9000
KANOON_S3_REGION=us-east-1
KANOON_S3_BUCKET=kanoon-media
KANOON_S3_ACCESS_KEY=minioadmin
KANOON_S3_SECRET_KEY=minioadmin
# One-time CLI bootstrap only; omit after use and never commit a real value.
# KANOON_BOOTSTRAP_PASSWORD=
