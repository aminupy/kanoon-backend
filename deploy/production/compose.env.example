# Copy to .env.production, replace every placeholder, and chmod 600.
# This file is consumed by Docker Compose interpolation; it is not passed wholesale
# into runtime application containers.

KANOON_IMAGE=registry.example.com/kanoon-backend@sha256:REPLACE_WITH_IMAGE_DIGEST
KANOON_APP_ENV_FILE=.env.production.app
KANOON_DATA_PLANE_PORT=8000
KANOON_CONTROL_PLANE_PORT=8001

POSTGRES_DB=kanoon
POSTGRES_USER=kanoon_owner
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
KANOON_DB_APP_USER=kanoon_runtime
KANOON_DB_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_RUNTIME_PASSWORD

# URL-encode reserved characters in the password. This owner DSN is passed only to
# the one-shot migration container.
KANOON_MIGRATION_DATABASE_DSN=postgresql+psycopg://kanoon_owner:REPLACE_WITH_OWNER_PASSWORD@postgres:5432/kanoon
