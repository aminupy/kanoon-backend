# Copy to .env.production.app, replace every placeholder, and chmod 600.
# Do not place the PostgreSQL owner password in this runtime file.

KANOON_ENVIRONMENT=production
KANOON_DEBUG=false
KANOON_DATABASE_DSN=postgresql+psycopg://kanoon_runtime:REPLACE_WITH_RUNTIME_PASSWORD@postgres:5432/kanoon
KANOON_DATABASE_APPLICATION_ROLE=kanoon_app
KANOON_SIGNING_KEY=REPLACE_ME

KANOON_TRUST_FORWARDED_HOST=false
KANOON_TRUSTED_PROXY_CIDRS=[]
KANOON_ALLOWED_CORS_ORIGINS=["https://admin.example.com"]

# The selected application image must wire concrete OTPProvider and PaymentGateway
# adapters into create_app. These settings alone do not supply implementations.
KANOON_OTP_PROVIDER=external
KANOON_PAYMENT_PROVIDER=external
KANOON_PUBLIC_BASE_URL=https://school.example.com

KANOON_SITE_BUILD_WEBHOOK_URL=https://builder.internal.example/v1/builds
KANOON_SITE_BUILD_HMAC_SECRET=REPLACE_ME
KANOON_SITE_BUILD_MAX_ATTEMPTS=5
KANOON_SITE_BUILD_LEASE_SECONDS=300
KANOON_SITE_BUILD_POLL_SECONDS=5

KANOON_S3_ENDPOINT_URL=http://storage.service.internal:8333
KANOON_S3_PUBLIC_ENDPOINT_URL=https://storage.example.com
KANOON_S3_REGION=us-east-1
KANOON_S3_BUCKET=kanoon
KANOON_S3_ACCESS_KEY=REPLACE_ME
KANOON_S3_SECRET_KEY=REPLACE_ME
